# Dial & Form Environment Variables (Production / Docker)
# Copy to .env and customize values before deployment

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atelier_watch
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# JWT Authentication Secret (Minimum 256-bit / 32-character key)
# Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:8000

# Supabase Auth (URL and publishable key only; never use a service-role/secret key here)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
