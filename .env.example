# Atelier Watch Environment Variables (Production / Docker)
# Copy to .env and customize values before deployment

# Database Configuration (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/atelier_watch
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Authentication Secret (Minimum 256-bit / 32-character key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Allowed Frontend Origins (CORS)
FRONTEND_URL=http://localhost:8000
